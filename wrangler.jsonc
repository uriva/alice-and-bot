{
  "name": "alice-and-bot",
  "main": "dist/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.aliceandbot.com",
      "custom_domain": true,
      "zone_name": "aliceandbot.com"
    }
  ],
  "build": {
    "command": "deno run -A scripts/buildWorker.ts"
  },
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ALICE_DO",
        "class_name": "AliceDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AliceDO"]
    }
  ]
}
